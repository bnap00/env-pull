{
  "name": "env-pull",
  "version": "1.1.0",
  "description": "Pull .env updates from .env.example automatically. Keep your environment files in sync.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "env-pull": "bin/env-pull.js"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "env",
    "dotenv",
    "environment",
    "sync",
    "cli",
    "configuration",
    "env-example",
    "devops",
    "developer-tools",
    "git-hooks",
    "agent-skill",
    "skills-sh",
    "claude-code",
    "opencode"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bnap00/env-pull.git"
  },
  "bugs": {
    "url": "https://github.com/bnap00/env-pull/issues"
  },
  "homepage": "https://github.com/bnap00/env-pull#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
